{%- comment -%}
  Renders one of the outline icons used across the Dodge sections.
  Accepts: name (package | tag | truck | award | building | dna | shield | government | factory | leaf | flask | check)
{%- endcomment -%}
{%- assign n = name | default: 'check' -%}
<svg class="dodge-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case n -%}
    {%- when 'package' -%}
      <path d="M16 4 5 9.5v13L16 28l11-5.5v-13L16 4Z"/><path d="M5 9.5 16 15l11-5.5"/><path d="M16 15v13"/><path d="m10.5 6.75 11 5.5"/>
    {%- when 'tag' -%}
      <path d="M15.2 4H26v10.8L14.4 26.4a2 2 0 0 1-2.8 0l-8-8a2 2 0 0 1 0-2.8L15.2 4Z"/><circle cx="21" cy="11" r="1.6"/>
    {%- when 'truck' -%}
      <path d="M3 8h14v13H3z"/><path d="M17 12h5.5l3.5 4v5H17z"/><circle cx="8" cy="24" r="2.4"/><circle cx="21" cy="24" r="2.4"/>
    {%- when 'award' -%}
      <circle cx="16" cy="13" r="7"/><path d="m11.5 19-2 9 6.5-3.5L22.5 28l-2-9"/>
    {%- when 'building' -%}
      <path d="M6 28V8l10-4 10 4v20"/><path d="M2 28h28"/><path d="M12 28v-6h8v6"/><path d="M11 13h2m6 0h2m-10 5h2m6 0h2"/>
    {%- when 'dna' -%}
      <path d="M10 3c0 6 12 8 12 14S10 25 10 29"/><path d="M22 3c0 6-12 8-12 14s12 6 12 10"/><path d="M11.5 8h9M11.5 22h9M13 12h6M13 18h6"/>
    {%- when 'shield' -%}
      <path d="M16 3 6 7v8c0 7 4.5 11.5 10 14 5.5-2.5 10-7 10-14V7l-10-4Z"/><path d="m12 15.5 3 3 5.5-6"/>
    {%- when 'government' -%}
      <path d="M4 12 16 5l12 7"/><path d="M6 12v12m6-12v12m8-12v12m6-12v12"/><path d="M3 27h26"/>
    {%- when 'factory' -%}
      <path d="M3 28V14l7 4v-4l7 4V9l12 6v13z"/><path d="M9 28v-5h5v5"/>
    {%- when 'leaf' -%}
      <path d="M27 5c0 12-7 18-15 18a7 7 0 0 1-7-7C5 9 13 5 27 5Z"/><path d="M5 28C8 19 14 13 22 10"/>
    {%- when 'flask' -%}
      <path d="M13 3v9L5.5 24.5A3 3 0 0 0 8 29h16a3 3 0 0 0 2.5-4.5L19 12V3"/><path d="M11 3h10"/><path d="M9.5 20h13"/>
    {%- else -%}
      <circle cx="16" cy="16" r="12"/><path d="m11 16 3.5 3.5L21 12.5"/>
  {%- endcase -%}
</svg>
