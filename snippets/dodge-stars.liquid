{%- comment -%}
  Renders a five-star rating row.
  Accepts: size (px, default 18)
{%- endcomment -%}
{%- assign star_size = size | default: 18 -%}
<div class="dodge-stars" role="img" aria-label="{{ 'Rated 5 out of 5' }}">
  {%- for i in (1..5) -%}
    <svg width="{{ star_size }}" height="{{ star_size }}" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="m10 1.7 2.47 5.01 5.53.8-4 3.9.94 5.5L10 14.3l-4.94 2.6.94-5.5-4-3.9 5.53-.8L10 1.7Z"/>
    </svg>
  {%- endfor -%}
</div>
