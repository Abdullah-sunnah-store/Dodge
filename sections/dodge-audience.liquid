{%- liquid
  assign s = section.settings
-%}

<div class="dodge-section{% if s.band %} dodge-section--band{% endif %}">
  <div class="dodge-section__inner">
    <div class="dodge-head">
      {%- if s.heading != blank -%}
        <h2 class="dodge-head__title">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.subheading != blank -%}
        <p class="dodge-head__subtitle">{{ s.subheading }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="dodge-grid dodge-grid--3 dodge-audience">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <div class="dodge-card dodge-audience__card" {{ block.shopify_attributes }}>
            {%- if b.image != blank -%}
              {{ b.image | image_url: width: 96 | image_tag: class: 'dodge-audience__image', alt: '', loading: 'lazy' }}
            {%- else -%}
              {% render 'dodge-icon', name: b.icon %}
            {%- endif -%}
            {%- if b.title != blank -%}
              <h3 class="dodge-audience__title">{{ b.title }}</h3>
            {%- endif -%}
            {%- if b.text != blank -%}
              <p class="dodge-card__text">{{ b.text }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .dodge-audience__card {
    align-items: center;
    text-align: center;
    gap: 10px;
    padding: 28px 24px;
  }

  .dodge-audience__image {
    width: 34px;
    height: 34px;
    object-fit: contain;
  }

  .dodge-audience__title {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    color: var(--dodge-ink);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dodge — Who we work with",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Who We Work With"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Supporting organizations across research, healthcare, industry, and commercial service environments."
    },
    {
      "type": "checkbox",
      "id": "band",
      "label": "Use light background",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "audience",
      "name": "Audience",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "building", "label": "Institution" },
            { "value": "dna", "label": "Biotechnology" },
            { "value": "shield", "label": "Healthcare" },
            { "value": "government", "label": "Government" },
            { "value": "factory", "label": "Manufacturing" },
            { "value": "leaf", "label": "Agriculture" },
            { "value": "flask", "label": "Flask" }
          ],
          "default": "building"
        },
        { "type": "image_picker", "id": "image", "label": "Custom icon image" },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Academic & Research Institutions"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Supporting universities, research institutes, and innovation centers."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dodge — Who we work with",
      "blocks": [
        { "type": "audience" },
        { "type": "audience" },
        { "type": "audience" },
        { "type": "audience" },
        { "type": "audience" },
        { "type": "audience" }
      ]
    }
  ]
}
{% endschema %}
