{%- liquid
  assign s = section.settings
-%}

<div class="dodge-section{% if s.band %} dodge-section--band{% endif %} dodge-support">
  <div class="dodge-section__inner dodge-support__inner">
    {%- if s.heading != blank -%}
      <h2 class="dodge-head__title">{{ s.heading }}</h2>
    {%- endif -%}

    {%- if s.text_1 != blank -%}
      <p class="dodge-support__text">{{ s.text_1 }}</p>
    {%- endif -%}

    {%- if s.text_2 != blank -%}
      <p class="dodge-support__text">{{ s.text_2 }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="dodge-support__actions">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <div class="dodge-support__action" {{ block.shopify_attributes }}>
            <a
              class="dodge-btn dodge-support__button"
              {% if b.link != blank %}href="{{ b.link }}"{% else %}role="link" aria-disabled="true"{% endif %}
            >
              {{ b.label }}
              {% render 'dodge-arrow' %}
            </a>
            {%- if b.caption != blank -%}
              <span class="dodge-support__caption">{{ b.caption }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .dodge-support__inner {
    max-width: 952px;
    text-align: center;
  }

  .dodge-support__text {
    margin: 20px auto 0;
    max-width: 880px;
    font-size: 16px;
    line-height: 26px;
    color: var(--dodge-muted);
  }

  .dodge-support__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 32px;
    margin-block-start: 36px;
  }

  .dodge-support__action {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .dodge-support__button {
    min-width: 220px;
  }

  .dodge-support__caption {
    font-size: 14px;
    color: var(--dodge-muted);
  }

  @media screen and (max-width: 749px) {
    .dodge-support__actions {
      gap: 24px;
    }

    .dodge-support__action,
    .dodge-support__button {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dodge — Support CTA",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Supporting Your Research and Operations."
    },
    {
      "type": "textarea",
      "id": "text_1",
      "label": "Paragraph 1",
      "default": "High-quality consumables trusted by laboratories, biotechnology and pharmaceutical companies, healthcare providers, production teams, and specialized industries"
    },
    {
      "type": "textarea",
      "id": "text_2",
      "label": "Paragraph 2",
      "default": "Request a quote or free samples to evaluate our products with confidence before purchase."
    },
    {
      "type": "checkbox",
      "id": "band",
      "label": "Use light background",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "action",
      "name": "Action",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Button label",
          "default": "Request a Quote"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "Pricing & availability"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dodge — Support CTA",
      "blocks": [
        { "type": "action" },
        { "type": "action" },
        { "type": "action" }
      ]
    }
  ]
}
{% endschema %}
