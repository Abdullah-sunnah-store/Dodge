{%- liquid
  assign s = section.settings
  assign form_id = 'DodgeContactForm-' | append: section.id
-%}

<div class="dodge-section{% if s.band %} dodge-section--band{% endif %}">
  <div class="dodge-section__inner">
    <div class="dodge-contact">
      <div class="dodge-contact__aside">
        {%- if s.heading != blank -%}
          <h2 class="dodge-contact__heading">{{ s.heading }}</h2>
        {%- endif -%}

        <div class="dodge-card dodge-contact__details">
          {%- if s.details_title != blank -%}
            <h3 class="dodge-contact__details-title">{{ s.details_title }}</h3>
          {%- endif -%}
          {%- if s.phone != blank -%}
            <p class="dodge-contact__line">
              {{ s.phone_label }} <a href="tel:{{ s.phone | replace: ' ', '' | replace: '-', '' }}">{{ s.phone }}</a>
            </p>
          {%- endif -%}
          {%- if s.email != blank -%}
            <p class="dodge-contact__line">
              {{ s.email_label }} <a href="mailto:{{ s.email }}">{{ s.email }}</a>
            </p>
          {%- endif -%}
        </div>
      </div>

      <div class="dodge-contact__panel">
        {%- form 'contact', id: form_id, class: 'dodge-contact__form' -%}
          <input type="hidden" name="contact[id]" value="{{ form_id }}">

          {%- liquid
            assign form_matches = false
            if form.id == form_id or form.id == blank
              assign form_matches = true
            endif
          -%}

          {%- if form.errors and form_matches -%}
            <p class="dodge-form__error" tabindex="-1" autofocus>
              {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
            </p>
          {%- endif -%}

          {%- if form.posted_successfully? and form_matches -%}
            <p class="dodge-form__status" tabindex="-1" autofocus>{{ s.success_message }}</p>
          {%- endif -%}

          <div class="dodge-form__grid">
            <div class="dodge-field">
              <label class="dodge-field__label" for="{{ form_id }}-name">{{ s.label_name }}</label>
              <input class="dodge-field__input" id="{{ form_id }}-name" type="text" name="contact[name]" autocomplete="name">
            </div>

            <div class="dodge-field">
              <label class="dodge-field__label" for="{{ form_id }}-company">{{ s.label_company }}</label>
              <input class="dodge-field__input" id="{{ form_id }}-company" type="text" name="contact[company]" autocomplete="organization">
            </div>

            <div class="dodge-field">
              <label class="dodge-field__label" for="{{ form_id }}-email">{{ s.label_email }}</label>
              <input class="dodge-field__input" id="{{ form_id }}-email" type="email" name="contact[email]" autocomplete="email" required>
            </div>

            <div class="dodge-field">
              <label class="dodge-field__label" for="{{ form_id }}-phone">{{ s.label_phone }}</label>
              <input class="dodge-field__input" id="{{ form_id }}-phone" type="tel" name="contact[phone]" autocomplete="tel">
            </div>

            <div class="dodge-field dodge-field--full">
              <label class="dodge-field__label" for="{{ form_id }}-message">{{ s.label_message }}</label>
              <textarea class="dodge-field__textarea" id="{{ form_id }}-message" name="contact[body]"></textarea>
            </div>
          </div>

          <button type="submit" class="dodge-btn dodge-contact__submit">{{ s.button_label }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .dodge-contact {
    display: grid;
    grid-template-columns: 430fr 770fr;
    gap: 32px;
    align-items: start;
  }

  .dodge-contact__heading {
    margin: 0 0 32px;
    font-size: 32px;
    line-height: 1.2;
    font-weight: 600;
    color: var(--dodge-ink);
  }

  .dodge-contact__details {
    gap: 8px;
  }

  .dodge-contact__details-title {
    margin: 0 0 8px;
    font-size: 18px;
    font-weight: 600;
    color: var(--dodge-ink);
  }

  .dodge-contact__line {
    margin: 0;
    font-size: 15px;
    line-height: 24px;
    color: var(--dodge-muted);
  }

  .dodge-contact__line a {
    color: inherit;
    text-decoration: none;
  }

  .dodge-contact__line a:hover {
    color: var(--dodge-primary);
  }

  .dodge-contact__panel {
    padding: 40px;
    background: #f7f9fa;
    border: 1px solid var(--dodge-card-border);
    border-radius: var(--dodge-card-radius);
  }

  .dodge-contact__submit {
    margin-block-start: 28px;
    min-width: 190px;
  }

  @media screen and (max-width: 989px) {
    .dodge-contact { grid-template-columns: minmax(0, 1fr); }
  }

  @media screen and (max-width: 749px) {
    .dodge-contact__panel { padding: 24px; }
    .dodge-contact__heading { font-size: 26px; margin-block-end: 20px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dodge — Contact",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact Our Team" },
    { "type": "text", "id": "details_title", "label": "Details title", "default": "Contact Details" },
    { "type": "text", "id": "phone_label", "label": "Phone label", "default": "Phone:" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "707-749-6444" },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "Email:" },
    { "type": "text", "id": "email", "label": "Email", "default": "info@dodgescientific.com" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Submit" },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks — your message is on its way to our team."
    },
    { "type": "checkbox", "id": "band", "label": "Use light background", "default": false },
    { "type": "header", "content": "Field labels" },
    { "type": "text", "id": "label_name", "label": "Name", "default": "Name" },
    { "type": "text", "id": "label_company", "label": "Company", "default": "Company or Organization" },
    { "type": "text", "id": "label_email", "label": "Email", "default": "Email Address" },
    { "type": "text", "id": "label_phone", "label": "Phone", "default": "Phone Number" },
    { "type": "text", "id": "label_message", "label": "Message", "default": "Message" }
  ],
  "presets": [
    {
      "name": "Dodge — Contact"
    }
  ]
}
{% endschema %}
