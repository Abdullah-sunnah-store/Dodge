{%- liquid
  assign s = section.settings
-%}

<div class="dodge-section{% if s.band %} dodge-section--band{% endif %}">
  <div class="dodge-section__inner">
    <div class="dodge-head">
      {%- if s.heading != blank -%}
        <h2 class="dodge-head__title">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.text != blank -%}
        <p class="dodge-head__subtitle dodge-logos__lede">{{ s.text }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="dodge-logos" style="--dodge-logo-height: {{ s.logo_height }}px;">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <div class="dodge-logos__item" {{ block.shopify_attributes }}>
            {%- if b.image != blank -%}
              {%- capture logo -%}
                {{
                  b.image
                  | image_url: width: 600
                  | image_tag:
                    class: 'dodge-logos__image',
                    widths: '150, 300, 450, 600',
                    sizes: '200px',
                    alt: b.image.alt | default: b.name,
                    loading: 'lazy'
                }}
              {%- endcapture -%}
              {%- if b.link != blank -%}
                <a href="{{ b.link }}">{{ logo }}</a>
              {%- else -%}
                {{ logo }}
              {%- endif -%}
            {%- elsif b.name != blank -%}
              <span class="dodge-logos__name">{{ b.name }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .dodge-logos__lede {
    max-width: 1060px;
  }

  .dodge-logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 40px 56px;
  }

  .dodge-logos__item {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dodge-logos__image {
    height: var(--dodge-logo-height, 44px);
    width: auto;
    max-width: 220px;
    object-fit: contain;
  }

  .dodge-logos__name {
    font-size: 18px;
    font-weight: 600;
    color: var(--dodge-muted);
  }

  @media screen and (max-width: 749px) {
    .dodge-logos { gap: 28px 32px; }
    .dodge-logos__image { height: calc(var(--dodge-logo-height, 44px) * 0.8); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dodge — Trusted logos",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trusted by Leading Research & Scientific Organizations"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Dodge Scientific supports laboratories and organizations across academic research, biotechnology, healthcare, and commercial industries. Our focus on quality products, reliable supply, and responsive service has earned the trust of institutions and professionals across the United States and internationally."
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "checkbox",
      "id": "band",
      "label": "Use light background",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo" },
        { "type": "text", "id": "name", "label": "Name (fallback text)" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dodge — Trusted logos",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
