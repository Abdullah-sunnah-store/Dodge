{%- liquid
  assign s = section.settings
-%}

<div class="dodge-section{% if s.band %} dodge-section--band{% endif %}">
  <div class="dodge-section__inner dodge-manufacturing">
    {%- if s.badge != blank -%}
      <div class="dodge-manufacturing__badge">
        {{
          s.badge
          | image_url: width: 400
          | image_tag:
            widths: '120, 200, 300, 400',
            sizes: '140px',
            alt: s.badge.alt | default: s.heading,
            loading: 'lazy'
        }}
      </div>
    {%- endif -%}

    {%- if s.heading != blank -%}
      <h2 class="dodge-head__title">{{ s.heading }}</h2>
    {%- endif -%}

    {%- if s.text_1 != blank -%}
      <p class="dodge-manufacturing__text">{{ s.text_1 }}</p>
    {%- endif -%}

    {%- if s.text_2 != blank -%}
      <p class="dodge-manufacturing__text">{{ s.text_2 }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="dodge-grid dodge-grid--3 dodge-manufacturing__cards">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <div class="dodge-card dodge-manufacturing__card" {{ block.shopify_attributes }}>
            {%- if b.title != blank -%}
              <h3 class="dodge-manufacturing__card-title">{{ b.title }}</h3>
            {%- endif -%}
            {%- if b.text != blank -%}
              <p class="dodge-card__text">{{ b.text }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .dodge-manufacturing {
    text-align: center;
  }

  .dodge-manufacturing__badge img {
    width: 140px;
    height: auto;
    margin-inline: auto;
    margin-block-end: 24px;
  }

  .dodge-manufacturing__text {
    margin: 16px auto 0;
    max-width: 900px;
    font-size: 15px;
    line-height: 24px;
    color: var(--dodge-muted);
  }

  .dodge-manufacturing__cards {
    margin-block-start: 40px;
  }

  .dodge-manufacturing__card {
    text-align: center;
    padding: 24px 22px;
  }

  .dodge-manufacturing__card-title {
    margin: 0 0 8px;
    font-size: 16px;
    font-weight: 600;
    color: var(--dodge-ink);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dodge — Manufacturing",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "badge",
      "label": "Badge image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Strategic U.S. Manufacturing Partnerships"
    },
    {
      "type": "textarea",
      "id": "text_1",
      "label": "Paragraph 1",
      "default": "Dodge Scientific works with U.S. based manufacturing partners to support reliable supply, consistent product quality, and full traceability across key product lines."
    },
    {
      "type": "textarea",
      "id": "text_2",
      "label": "Paragraph 2",
      "default": "These partnerships strengthen our ability to deliver dependable products while remaining responsive to the needs of laboratories, healthcare providers, and commercial service environments."
    },
    {
      "type": "checkbox",
      "id": "band",
      "label": "Use light background",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Reliable Supply Chains" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Working with established U.S. manufacturing partners helps ensure consistent product availability and dependable fulfillment."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dodge — Manufacturing",
      "blocks": [
        { "type": "pillar" },
        { "type": "pillar" },
        { "type": "pillar" }
      ]
    }
  ]
}
{% endschema %}
