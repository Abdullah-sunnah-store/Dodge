{%- liquid
  assign s = section.settings
  assign products = s.collection.products
  assign limit = s.products_to_show
-%}

<div class="dodge-section{% if s.band %} dodge-section--band{% endif %}">
  <div class="dodge-section__inner">
    <div class="dodge-head">
      {%- if s.heading != blank -%}
        <h2 class="dodge-head__title">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.subheading != blank -%}
        <p class="dodge-head__subtitle">{{ s.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="dodge-grid dodge-grid--4 dodge-products">
      {%- if products.size > 0 -%}
        {%- for product in products limit: limit -%}
          {%- assign variant = product.selected_or_first_available_variant -%}
          <div class="dodge-card dodge-products__card">
            <a class="dodge-card__media dodge-products__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              {%- if product.featured_media != blank -%}
                {{
                  product.featured_media
                  | image_url: width: 800
                  | image_tag:
                    widths: '200, 320, 480, 640, 800',
                    sizes: '(min-width: 990px) 250px, (min-width: 750px) 40vw, 80vw',
                    alt: product.featured_media.alt | default: product.title,
                    loading: 'lazy'
                }}
              {%- else -%}
                {{ 'product-apparel-2' | placeholder_svg_tag: 'dodge-products__placeholder' }}
              {%- endif -%}
            </a>

            <h3 class="dodge-card__title dodge-products__title">
              <a href="{{ product.url }}">{{ product.title }}</a>
            </h3>

            {%- if s.show_description -%}
              {%- assign blurb = product.description | strip_html | truncatewords: 14 -%}
              {%- if blurb != blank -%}
                <p class="dodge-card__text dodge-products__text">{{ blurb }}</p>
              {%- endif -%}
            {%- endif -%}

            <p class="dodge-products__price">
              {%- if s.price_prefix != blank -%}{{ s.price_prefix }} {% endif -%}
              {{ product.price | money }}
            </p>

            {%- assign product_form_id = 'DodgeProductForm-' | append: section.id | append: '-' | append: product.id -%}
            <product-form-component
              class="dodge-products__form"
              data-section-id="{{ section.id }}"
              data-product-id="{{ product.id }}"
              data-product-url="{{ product.url }}"
              on:submit="/handleSubmit"
              data-quantity-default="1"
            >
              <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
              {%- form 'product', product, id: product_form_id, data-type: 'add-to-cart-form' -%}
                <input type="hidden" name="id" ref="variantId" value="{{ variant.id }}">
                <button
                  type="submit"
                  name="add"
                  class="dodge-btn dodge-btn--block"
                  {% unless product.available %}disabled{% endunless %}
                >
                  {%- if product.available -%}
                    {{ s.button_label }}
                    {% render 'dodge-arrow' %}
                  {%- else -%}
                    {{ 'products.product.sold_out' | t }}
                  {%- endif -%}
                </button>
              {%- endform -%}
            </product-form-component>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          <div class="dodge-card dodge-products__card">
            <div class="dodge-card__media dodge-products__media">
              {{ 'product-apparel-2' | placeholder_svg_tag: 'dodge-products__placeholder' }}
            </div>
            <h3 class="dodge-card__title dodge-products__title">{{ 'placeholders.product_title' | t }}</h3>
            <p class="dodge-products__price">{{ s.price_prefix }} {{ 4950 | money }}</p>
            <span class="dodge-btn dodge-btn--block">{{ s.button_label }}{% render 'dodge-arrow' %}</span>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .dodge-products__card {
    text-align: center;
    padding: 20px;
  }

  .dodge-products__media {
    margin-block-end: 20px;
  }

  .dodge-products__title {
    font-size: 18px;
    margin-block-end: 8px;
  }

  .dodge-products__title a {
    color: inherit;
    text-decoration: none;
  }

  .dodge-products__text {
    flex: 1 1 auto;
    margin-block-end: 16px;
  }

  .dodge-products__price {
    margin: 0 0 16px;
    font-size: 20px;
    font-weight: 600;
    color: var(--dodge-ink);
  }

  .dodge-products__form form {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dodge — Frequent orders",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Ordered Products"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Browse our core product categories."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show short description",
      "default": true
    },
    {
      "type": "text",
      "id": "price_prefix",
      "label": "Price prefix",
      "default": "Price:"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add to cart"
    },
    {
      "type": "checkbox",
      "id": "band",
      "label": "Use light background",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Dodge — Frequent orders"
    }
  ]
}
{% endschema %}
