{%- liquid
  assign s = section.settings
-%}

<div class="dodge-section{% if s.band %} dodge-section--band{% endif %}">
  <div class="dodge-section__inner">
    <div class="dodge-why">
      <div class="dodge-why__panel">
        {%- if s.image != blank -%}
          {{
            s.image
            | image_url: width: 1200
            | image_tag:
              class: 'dodge-why__image',
              widths: '400, 600, 900, 1200',
              sizes: '(min-width: 990px) 570px, 92vw',
              alt: s.image.alt | default: s.heading,
              loading: 'lazy'
          }}
        {%- endif -%}

        <div class="dodge-why__panel-content">
          {%- if s.heading != blank -%}
            <h2 class="dodge-why__title">{{ s.heading }}</h2>
          {%- endif -%}
          {%- if s.text != blank -%}
            <p class="dodge-why__text">{{ s.text }}</p>
          {%- endif -%}
        </div>
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="dodge-why__features">
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            <div class="dodge-card dodge-why__feature" {{ block.shopify_attributes }}>
              {%- if b.image != blank -%}
                {{ b.image | image_url: width: 96 | image_tag: class: 'dodge-why__feature-image', alt: '', loading: 'lazy' }}
              {%- else -%}
                {% render 'dodge-icon', name: b.icon %}
              {%- endif -%}
              {%- if b.title != blank -%}
                <h3 class="dodge-why__feature-title">{{ b.title }}</h3>
              {%- endif -%}
              {%- if b.text != blank -%}
                <p class="dodge-card__text">{{ b.text }}</p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .dodge-why {
    display: grid;
    grid-template-columns: 570fr 606fr;
    gap: 24px;
    align-items: stretch;
  }

  .dodge-why__panel {
    position: relative;
    min-height: 340px;
    border-radius: var(--dodge-card-radius);
    overflow: hidden;
    background: linear-gradient(135deg, #eef6f8 0%, #d9ecf1 100%);
  }

  .dodge-why__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .dodge-why__panel-content {
    position: relative;
    padding: 32px;
    max-width: 320px;
  }

  .dodge-why__title {
    margin: 0;
    font-size: 26px;
    line-height: 1.25;
    font-weight: 500;
    color: var(--dodge-ink);
  }

  .dodge-why__text {
    margin: 12px 0 0;
    font-size: 14px;
    line-height: 22px;
    color: var(--dodge-muted);
  }

  .dodge-why__features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .dodge-why__feature {
    text-align: center;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .dodge-why__feature-image {
    width: 34px;
    height: 34px;
    object-fit: contain;
  }

  .dodge-why__feature-title {
    margin: 0;
    font-size: 16px;
    font-weight: 600;
    color: var(--dodge-ink);
  }

  @media screen and (max-width: 989px) {
    .dodge-why {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .dodge-why__features {
      grid-template-columns: minmax(0, 1fr);
    }

    .dodge-why__panel-content {
      max-width: none;
      padding: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dodge — Why choose",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Panel heading",
      "default": "Why Choose Scientific"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Panel text",
      "default": "Dependable supply chains, uncompromising quality, and the agility to keep your research moving forward."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Panel image"
    },
    {
      "type": "checkbox",
      "id": "band",
      "label": "Use light background",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "package", "label": "Package" },
            { "value": "tag", "label": "Tag" },
            { "value": "truck", "label": "Truck" },
            { "value": "award", "label": "Award" },
            { "value": "shield", "label": "Shield" },
            { "value": "flask", "label": "Flask" },
            { "value": "check", "label": "Check" }
          ],
          "default": "package"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom icon image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Reliable Supply"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Consistent product availability and dependable fulfillment."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dodge — Why choose",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
