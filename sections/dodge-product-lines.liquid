{%- liquid
  assign s = section.settings
-%}

<div class="dodge-section{% if s.band %} dodge-section--band{% endif %}">
  <div class="dodge-section__inner">
    <div class="dodge-head">
      {%- if s.heading != blank -%}
        <h2 class="dodge-head__title">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.subheading != blank -%}
        <p class="dodge-head__subtitle">{{ s.subheading }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="dodge-grid dodge-grid--4 dodge-lines">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <div class="dodge-card dodge-lines__card" {{ block.shopify_attributes }}>
            <div class="dodge-card__media dodge-lines__media">
              {%- if b.image != blank -%}
                {{
                  b.image
                  | image_url: width: 800
                  | image_tag:
                    widths: '200, 320, 480, 640, 800',
                    sizes: '(min-width: 990px) 250px, (min-width: 750px) 40vw, 80vw',
                    alt: b.image.alt | default: b.title,
                    loading: 'lazy'
                }}
              {%- else -%}
                {{ 'product-apparel-1' | placeholder_svg_tag: 'dodge-lines__placeholder' }}
              {%- endif -%}
            </div>

            {%- if b.title != blank -%}
              <h3 class="dodge-card__title dodge-lines__title">{{ b.title }}</h3>
            {%- endif -%}

            {%- if b.text != blank -%}
              <p class="dodge-card__text dodge-lines__text">{{ b.text }}</p>
            {%- endif -%}

            {%- if b.button_label != blank -%}
              <a
                class="dodge-btn dodge-lines__button"
                {% if b.button_link != blank %}href="{{ b.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
              >
                {{ b.button_label }}
                {% render 'dodge-arrow' %}
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if s.footer_label != blank -%}
      <div class="dodge-lines__footer">
        <a class="dodge-link" {% if s.footer_link != blank %}href="{{ s.footer_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>
          {{ s.footer_label }}
          {% render 'dodge-arrow', class: 'dodge-btn__arrow' %}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .dodge-lines__card {
    text-align: center;
    padding: 20px;
  }

  .dodge-lines__media {
    margin-block-end: 20px;
  }

  .dodge-lines__title {
    margin-block-end: 8px;
  }

  .dodge-lines__text {
    flex: 1 1 auto;
    margin-block-end: 20px;
  }

  .dodge-lines__button {
    width: 100%;
  }

  .dodge-lines__footer {
    margin-block-start: 40px;
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dodge — Product lines",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore Our Product Lines"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Browse our core product categories."
    },
    {
      "type": "checkbox",
      "id": "band",
      "label": "Use light background",
      "default": false
    },
    {
      "type": "header",
      "content": "Footer link"
    },
    {
      "type": "text",
      "id": "footer_label",
      "label": "Label",
      "default": "Explore Product Lines"
    },
    {
      "type": "url",
      "id": "footer_link",
      "label": "Link"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Product line",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Serum"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "High-quality serum for consistent and reliable cell culture performance."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Explore Product Lines"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dodge — Product lines",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
